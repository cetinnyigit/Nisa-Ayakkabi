# Neon Postgres — Dashboard > Connection string (Pooled connection)
# Sonuna ?sslmode=require eklenmiş olmalı.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Prisma migrate/studio için havuzlanmamış (direct) bağlantı — Neon'da "Direct connection"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Mutlak adres üreten her yer (sitemap, robots, e-posta bağlantıları) bunu kullanır.
# Üretimde MUTLAKA canlı alan adı olmalı — yoksa maildeki linkler localhost'a gider.
NEXT_PUBLIC_SITE_URL="https://nisayakkabi.com"

NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32  (ya da: npx auth secret)
NEXTAUTH_SECRET="your-secret-key-here"

# Vercel Blob (görsel yükleme)
BLOB_READ_WRITE_TOKEN=""

# Resend (sipariş + şifre sıfırlama e-postaları).
# BOŞSA HİÇ MAİL GİTMEZ — kod sessizce atlar, sipariş yine oluşur.
RESEND_API_KEY=""
# Gönderen adresi. Buradaki alan adı Resend > Domains'te "Verified" olmalı,
# aksi halde gönderim 403 ile reddedilir. Yanıtlar company.ts'teki
# supportEmail adresine yönlendirilir (gönderim adresinin gelen kutusu yoktur).
ORDER_EMAIL_FROM="Nisa Ayakkabı <siparis@nisayakkabi.com>"

# PayTR — mağaza paneli > Bilgi bölümünden alınır.
# Üçü de dolu olmadıkça ödeme adımı devre dışı kalır (sipariş yine oluşur).
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# Canlıya geçerken "0" yapın. Tanımsız/boşsa test modu açıktır.
PAYTR_TEST_MODE="1"
# PayTR panelinde Bildirim URL olarak şunu tanımlayın:
#   https://<alan-adiniz>/api/odeme/paytr/callback

# Seed ile oluşturulan admin: admin@nisaayakkabi.com
# Şifreyi burada belirleyebilirsin, boş bırakılırsa "admin123" kullanılır.
SEED_ADMIN_PASSWORD=""
